# Configuração do modo de demonstração, usada pelo INICIAR_DEMONSTRACAO.bat.
# O script copia este arquivo para .env na primeira execução.
#
# DB_MOTOR=sqlite dispensa o PostgreSQL: o banco é o arquivo demo.sqlite3,
# criado pelo comando "python manage.py criar_banco_demo".

DJANGO_SECRET_KEY=demonstracao-nao-usar-em-producao
DJANGO_DEBUG=True

DB_MOTOR=sqlite

# O script troca para groq se você colar uma chave quando ele pedir.
IA_PROVEDOR=simulado
IA_RESERVA=simulado
IA_TEMPO_LIMITE=12

GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
