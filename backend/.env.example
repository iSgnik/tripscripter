# Copie este arquivo para .env e preencha com os dados do seu ambiente.
# O .env está no .gitignore e nunca deve ser enviado ao repositório.

# Chave usada para assinar os tokens de acesso. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave

# True durante o desenvolvimento; False em qualquer ambiente público.
DJANGO_DEBUG=True

# Banco de dados. postgresql é o oficial, criado com os scripts de banco/.
# sqlite é o modo de demonstração, para computadores sem PostgreSQL: dispensa
# as linhas DB_ abaixo e usa o arquivo demo.sqlite3 (python manage.py criar_banco_demo).
DB_MOTOR=postgresql

# PostgreSQL 16, criado com os scripts de banco/
DB_NOME=tripscripter
DB_USUARIO=postgres
DB_SENHA=
DB_HOST=localhost
DB_PORTA=5432

# Inteligência artificial
# IA_PROVEDOR: groq, gemini ou simulado (sem internet, não precisa de chave)
# IA_RESERVA: simulado (usa o simulado se o provedor falhar) ou nenhuma
IA_PROVEDOR=simulado
IA_RESERVA=simulado
# Espera máxima pelo provedor, em segundos. Mantenha abaixo de 15 (RQ009).
IA_TEMPO_LIMITE=12

# Chave do Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

# Chave do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
